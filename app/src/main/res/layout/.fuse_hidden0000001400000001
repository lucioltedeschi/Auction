<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:paddingTop="20dp"
    android:paddingBottom="34dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <ImageView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_icon_circle"
            android:elevation="6dp"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_gavel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.08"
            android:text="AUCT.IO"
            android:textAlignment="center"
            android:textColor="#0F2742"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:letterSpacing="0.08"
            android:text="PREMIER AUCTION HOUSE"
            android:textAlignment="center"
            android:textColor="#C9A646"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_white"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter the Digital Gallery"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="2dp"
                android:text="Accedé a subastas exclusivas con identidad validada y operaciones seguras."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:letterSpacing="0.08"
                android:text="DOCUMENTO"
                android:textColor="#0F2742"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDocumento"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_premium"
                android:hint="30123456"
                android:inputType="number"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.08"
                android:text="CLAVE SEGURA"
                android:textColor="#0F2742"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtClave"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_premium"
                android:hint="********"
                android:inputType="textPassword"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text=""
                android:textAlignment="center"
                android:textColor="#DC2626"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_gold"
                android:text="INGRESAR"
                android:textColor="#061826"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="¿No tenés cuenta? Solicitá tu validación KYC"
                android:textAlignment="center"
                android:textColor="#0F2742"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="2dp"
            android:text="Acceso seguro · Identidad verificada · Medios de pago validados"
            android:textAlignment="center"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>