<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F0E8"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#071827"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnVolverFlujoPago"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_nav_icon_circle"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="AUCT.IO"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTituloFlujoPago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.10"
                android:text="MEDIO DE PAGO"
                android:textColor="#A8872F"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="22dp"
            android:paddingRight="18dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/txtDescripcionFlujoPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Completá los datos para que la empresa verifique el medio."
                android:textColor="#475569"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <Spinner
                android:id="@+id/spMonedaFlujoPago"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp" />

            <Spinner
                android:id="@+id/spExtranjeraFlujoPago"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp" />

            <EditText
                android:id="@+id/edtEntidadFlujoPago"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Entidad"
                android:padding="14dp"
                android:textColor="#071827"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtReferenciaFlujoPago"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Referencia"
                android:padding="14dp"
                android:textColor="#071827"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <!-- Panel tarjeta — visible para alta de tarjeta -->
            <LinearLayout
                android:id="@+id/panelDatosTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_premium"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="DATOS DE TARJETA"
                    android:textColor="#A8872F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNumeroTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_premium"
                    android:hint="Número de tarjeta"
                    android:inputType="number"
                    android:maxLength="19"
                    android:padding="14dp"
                    android:textColor="#071827"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/edtNombreTitularTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_premium"
                    android:hint="Nombre del titular"
                    android:padding="14dp"
                    android:textColor="#071827"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/edtApellidoTitularTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_premium"
                    android:hint="Apellido del titular"
                    android:padding="14dp"
                    android:textColor="#071827"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/edtVencimientoTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_premium"
                    android:hint="Vencimiento MM/AA"
                    android:inputType="text"
                    android:maxLength="5"
                    android:padding="14dp"
                    android:textColor="#071827"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/edtCodigoSeguridadTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_premium"
                    android:hint="Código de seguridad"
                    android:inputType="numberPassword"
                    android:maxLength="4"
                    android:padding="14dp"
                    android:textColor="#071827"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />

            </LinearLayout>

            <EditText
                android:id="@+id/edtMontoChequeFlujoPago"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Monto certificado"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:textColor="#071827"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtMensajeFlujoPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text=""
                android:textAlignment="center"
                android:textColor="#DC2626"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btnGuardarFlujoPago"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_gold"
                android:text="GUARDAR"
                android:textColor="#071827"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
