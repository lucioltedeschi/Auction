<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F0E8"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingTop="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="28dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="9dp"
                    android:src="@drawable/ic_gavel" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.10"
                        android:text="AUCT.IO"
                        android:textColor="#071827"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="CONSIGNAR ARTÍCULO"
                        android:textColor="#A8872F"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- HERO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_dark_premium"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/txtTituloSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Solicitar subasta de artículo"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDescripcionSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Cargá los datos del bien que querés proponer para una futura subasta."
                    android:textColor="#D7E3EF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_gold_chip"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="CONSIGNACIÓN VERIFICADA"
                    android:textColor="#071827"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- FORM CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_premium"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="DATOS DEL ARTÍCULO"
                    android:textColor="#A8872F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtDescripcionCatalogo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_premium"
                    android:hint="Título corto para catálogo"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="#071827"
                    android:textColorHint="#94A3B8" />

                <EditText
                    android:id="@+id/edtDescripcionCompleta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_premium"
                    android:gravity="top"
                    android:hint="Descripción completa"
                    android:minLines="3"
                    android:padding="14dp"
                    android:textColor="#071827"
                    android:textColorHint="#94A3B8" />

                <EditText
                    android:id="@+id/edtHistoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_premium"
                    android:gravity="top"
                    android:hint="Historia, contexto o datos relevantes"
                    android:minLines="3"
                    android:padding="14dp"
                    android:textColor="#071827"
                    android:textColorHint="#94A3B8" />

                <EditText
                    android:id="@+id/edtArtista"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_premium"
                    android:hint="Artista o diseñador, si corresponde"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="#071827"
                    android:textColorHint="#94A3B8" />

                <EditText
                    android:id="@+id/edtPrecioBaseSugerido"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_premium"
                    android:hint="Precio base sugerido"
                    android:inputType="numberDecimal"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="#071827"
                    android:textColorHint="#94A3B8" />

                <!-- FOTOS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="0.08"
                    android:text="FOTOS DEL BIEN (MÍNIMO 6)"
                    android:textColor="#A8872F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFoto1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:text="FOTO 1"
                    android:textColor="#071827"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFoto1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Foto 1 pendiente"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnFoto2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_outline"
                    android:text="FOTO 2"
                    android:textColor="#071827"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFoto2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Foto 2 pendiente"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnFoto3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_outline"
                    android:text="FOTO 3"
                    android:textColor="#071827"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFoto3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Foto 3 pendiente"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnFoto4"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_outline"
                    android:text="FOTO 4"
                    android:textColor="#071827"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFoto4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Foto 4 pendiente"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnFoto5"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_outline"
                    android:text="FOTO 5"
                    android:textColor="#071827"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFoto5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Foto 5 pendiente"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnFoto6"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_outline"
                    android:text="FOTO 6"
                    android:textColor="#071827"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFoto6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Foto 6 pendiente"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <!-- DECLARACIONES -->
                <CheckBox
                    android:id="@+id/chkPropiedad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Declaro que el bien me pertenece y no posee impedimentos para ser subastado."
                    android:textColor="#334155"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/chkOrigenLicito"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Declaro que el origen del bien es lícito."
                    android:textColor="#334155"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtMensajeSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text=""
                    android:textAlignment="center"
                    android:textColor="#DC2626"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEnviarSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_gold"
                    android:text="ENVIAR SOLICITUD"
                    android:textColor="#071827"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- MIS CONSIGNACIONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mis consignaciones"
                    android:textColor="#071827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Button
                android:id="@+id/btnActualizarMisSolicitudes"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_dark"
                android:text="ACTUALIZAR MIS CONSIGNACIONES"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMisSolicitudes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_metric_box"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="Mis consignaciones: sin cargar."
                android:textColor="#334155"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnVolverSolicitud"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_outline"
                android:text="VOLVER"
                android:textColor="#071827"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
