<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F3F0E8" android:fitsSystemWindows="true" android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="64dp"
        android:background="#F3F0E8" android:elevation="3dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="18dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.10" android:text="AUCT.IO" android:textColor="#071827"
                android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.12" android:text="MI ACTIVIDAD" android:textColor="#A8872F"
                android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tu desempeño en Auct.io" android:textColor="#071827"
                android:textSize="25sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtEstadoEstadisticas" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Preparando indicadores..." android:textColor="#64748B" android:textSize="13sp" />

            <GridLayout android:id="@+id/gridMetricas" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:columnCount="2" android:orientation="horizontal" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="Participación por categoría"
                android:textColor="#071827" android:textSize="19sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/contenedorCategorias" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="Actividad reciente"
                android:textColor="#071827" android:textSize="19sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/contenedorActividad" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" android:paddingBottom="18dp" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/component_bottom_nav" />
</LinearLayout>
