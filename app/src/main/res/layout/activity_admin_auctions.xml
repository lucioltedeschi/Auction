<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F0E8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="#071827"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBackAdminAuctions"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver al panel interno"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GESTIÓN DE SUBASTAS"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alta · modificación · baja segura"
                android:textColor="#C9D5E2"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="Administración de subastas"
            android:padding="10dp"
            android:src="@drawable/ic_nav_auctions" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Creá el evento y su catálogo en una sola operación. Las subastas con actividad no se eliminan: se cancelan para conservar la trazabilidad."
                android:textColor="#475569"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtAdminAuctionFormTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NUEVA SUBASTA"
                    android:textColor="#071827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtAdminAuctionLocation"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_premium"
                    android:hint="Ubicación o nombre del evento"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtAdminAuctionDate"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_premium"
                        android:hint="AAAA-MM-DD"
                        android:inputType="date"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/edtAdminAuctionTime"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_premium"
                        android:hint="HH:MM"
                        android:inputType="time"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Estado · categoría · moneda"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spAdminAuctionState"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_premium" />

                    <Spinner
                        android:id="@+id/spAdminAuctionCategory"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_premium" />

                    <Spinner
                        android:id="@+id/spAdminAuctionCurrency"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_premium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtAdminAuctionCapacity"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_premium"
                        android:hint="Capacidad"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/edtAdminAuctionDuration"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_premium"
                        android:hint="Minutos por lote"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Depósito · seguridad propia"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spAdminAuctionDeposit"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_premium" />

                    <Spinner
                        android:id="@+id/spAdminAuctionSecurity"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_premium" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSaveAdminAuction"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_gold"
                    android:text="CREAR SUBASTA Y CATÁLOGO"
                    android:textColor="#071827"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCancelAdminAuctionEdit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_outline"
                    android:text="CANCELAR EDICIÓN"
                    android:textColor="#071827"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SUBASTAS REGISTRADAS"
                    android:textColor="#071827"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefreshAdminAuctions"
                    android:layout_width="112dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_gold"
                    android:drawableStart="@drawable/ic_action_refresh"
                    android:drawablePadding="6dp"
                    android:text="RECARGAR"
                    android:textColor="#071827"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtAdminAuctionsMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Cargando subastas…"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/containerAdminAuctions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
