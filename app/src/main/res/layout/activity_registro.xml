<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F0E8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registro de postor"
            android:letterSpacing="0.04"
            android:textColor="#071827"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Paso 1: cargá tus datos y documentación. La empresa revisa la solicitud antes de habilitar la clave."
            android:textColor="#64748B"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_button_dark"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <View
                android:layout_width="46dp"
                android:layout_height="1dp"
                android:background="#CBD5E1" />

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="#E2E8F0"
                android:gravity="center"
                android:text="2"
                android:textColor="#071827"
                android:textStyle="bold" />

            <View
                android:layout_width="46dp"
                android:layout_height="1dp"
                android:background="#CBD5E1" />

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="#E2E8F0"
                android:gravity="center"
                android:text="3"
                android:textColor="#071827"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Datos personales"
            android:letterSpacing="0.04"
            android:textColor="#071827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDocumento"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_premium"
            android:hint="DNI o pasaporte"
            android:inputType="number"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Nombre"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etApellido"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Apellido"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etDireccion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Domicilio legal"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Teléfono"
            android:inputType="phone"
            android:padding="12dp" />

        <Spinner
            android:id="@+id/etPais"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_premium"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Fotos del documento: frente y dorso"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSeleccionarDniFrente"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:text="Seleccionar frente del DNI"
            android:textColor="#071827"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDniFrente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Frente pendiente"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSeleccionarDniDorso"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:text="Seleccionar dorso del DNI"
            android:textColor="#071827"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDniDorso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Dorso pendiente"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_button_dark"
            android:text="Enviar solicitud"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMensajeRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="#475569"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_premium"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paso 3: generar clave"
                android:textColor="#071827"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Usá este bloque cuando la empresa ya aprobó tu solicitud y te asignó categoría."
                android:textColor="#64748B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etDocumentoPaso2"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_premium"
                android:hint="DNI o pasaporte aprobado"
                android:inputType="number"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etClavePaso2"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Clave personal"
                android:inputType="textPassword"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnCompletarRegistro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_gold"
                android:text="Generar clave"
                android:textColor="#071827"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMensajePaso2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textAlignment="center"
                android:textColor="#475569"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

